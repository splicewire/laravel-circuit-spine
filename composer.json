{
    "name": "splicewire/laravel-circuit-spine",
    "description": "The circuit spine's shared value vocabulary: the typed {type, payload} Envelope, Port + PortValidator contract, Graph Node/Edge wire DTOs, Run/NodeRun status enums and records, and the RunContext provenance object. The heavy circuit kernel (scheduling, dispatch, cycle detection) stays private; this is the data surface satellites and hosts share without it.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Circuits\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Circuits\\Tests\\": "tests/"
        }
    },
    "extra": {
        "package-topology": {
            "because": "the spine keeps its noun VOs; it must never reach up into the engine process subtrees",
            "sourceNeverReferences": [
                "Splicewire\\Circuits\\Execution\\",
                "Splicewire\\Circuits\\Validation\\",
                "Splicewire\\Circuits\\Dispatch\\",
                "Splicewire\\Circuits\\Scheduling\\"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "merge-plugin": {
            "merge-dev": true,
            "include": [
                "composer.local.json"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^11.0",
        "rushing/php-package-topology": "dev-main",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-graphine.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-package-topology.git"
        }
    ]
}
